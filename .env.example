# 必填：生成独立随机值后写入 .env.local，不要将真实密钥发给他人。
AUTH_SECRET=

# 可选：配置后启用 DeepSeek；不配置时使用校园规则功能和本地占位回复。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：本地单进程体验可以不填，使用本地 PGlite 数据库。
# POSTGRES_URL=
# REDIS_URL=

# 可选：图片搜索（内置实现，不需要任何 API key）。
# 默认 bing（cn.bing.com，境内可直连）；设为 duckduckgo 需要海外出网。
# IMAGE_SEARCH_PROVIDER=bing
# 设为 1 时彻底过滤商用图库；默认只降权排序并标注来源。
# IMAGE_SEARCH_BLOCK_STOCK=0
# 配置后，搜索抓取的图片存到 Vercel Blob；不配置则写到 public/uploads（Vercel 上不可写）。
# BLOB_READ_WRITE_TOKEN=
